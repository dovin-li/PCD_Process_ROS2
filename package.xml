<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tron2_pcd_process</name>
  <version>0.2.0</version>
  <description>
    ROS2 版 PCD Process：把 FAST-LIO 的 world 系点云 + 位姿处理成静态点云 PCD 与 2D 占据栅格地图。
    核心处理层是纯 Python（numpy/scipy），不 import rclpy；离线节点直读 ROS2 bag，
    在线节点订阅话题边建图边出图。取代 ROS1 版 ~/Desktop/测试/point_process。
  </description>
  <maintainer email="dovin.lee@example.com">Dovin Li</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
